	ld	(ix - 3), de
	or	a, a
	sbc	hl, hl
	ld	de, (ix + 15)
	ld	l, e
	ld	h, d
	ld	(ix - 15), hl
	ld	iy, (ix + 6)
	lea	hl, iy + 4
	ld	(ix - 9), hl
BB47_4:
	ld	hl, (ix + 12)
	add.sis	hl, bc
	or	a, a
	sbc.sis	hl, bc
	jr	z, BB47_7
	ld	hl, (ix - 3)
	ld	de, (ix - 6)
	ld	iy, (ix - 9)
BB47_6:
	ld	(ix - 12), iy
	push	de
	pop	iy
	ld	a, (iy)
	ld	iy, (ix - 12)
	ld	(iy), a
	inc	iy
	inc	de
	dec	hl
	add	hl, bc
	or	a, a
	sbc	hl, bc
	jr	nz, BB47_6
BB47_7:
	inc	bc
	ld	de, (ix - 3)
	ld	hl, (ix - 9)
	add	hl, de
	ld	(ix - 9), hl
	ld	hl, (ix - 6)
	add	hl, de
	ld	(ix - 6), hl
	push	bc
	pop	hl
	ld	de, (ix - 15)
	or	a, a
	sbc	hl, de
	jp	nz, BB47_4
BB47_8:
	ld	sp, ix
	pop	ix
	ret
