	public	_tilemap_init
_tilemap_init:
	push	ix
	ld	ix, 0
	add	ix, sp
	ld	bc, (ix + 9)
	ld	iy, (ix + 12)
	ld.sis	de, 128
	ld	l, c
	ld	h, b
	sbc.sis	hl, de
	jr	c, BB46_2
	ld.sis	hl, 128
	ld	c, l
	ld	b, h
BB46_2:
	ex	de, hl
	ld	e, iyl
	ld	d, iyh
	ex	de, hl
	ld.sis	de, 128
	or	a, a
	sbc.sis	hl, de
	jr	c, BB46_4
	ld.sis	hl, 128
	ex	de, hl
	ld	iyl, e
	ld	iyh, d
	ex	de, hl
BB46_4:
	ld	hl, (ix + 6)
	ld	(hl), c
	inc	hl
	ld	(hl), b
	dec	hl
	lea	de, iy
	push	hl
	pop	iy
	ld	(iy + 2), e
	ld	(iy + 3), d
	ld	l, e
	ld	h, d
	call	__smulu
	add.sis	hl, bc
	or	a, a
	sbc.sis	hl, bc
	jr	z, BB46_6
	ld	a, (ix + 15)
	ld	de, 0
	ld	e, l
	ld	d, h
	push	de
	ld	l, a
	push	hl
	ld	iy, (ix + 6)
	pea	iy + 4
	call	_memset
	ld	hl, 9
	add	hl, sp
	ld	sp, hl
BB46_6:
	pop	ix
	ret
